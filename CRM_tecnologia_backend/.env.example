# ==============================================================
# HARDCRM PRO — Variables de Entorno (EJEMPLO)
# ==============================================================
# Copia este archivo como .env y completa los valores reales.
#   cp .env.example .env
# El archivo .env real NUNCA debe subirse a Git.
# ==============================================================


# ==============================================================
# BASE DE DATOS — Supabase (PostgreSQL)
# ==============================================================
# Obtén la URL en: Supabase → Tu proyecto → Settings → Database
# Sección "Connection string" → modo "URI"
# Reemplaza [TU-PASSWORD] con la contraseña de tu proyecto.

DATABASE_URL=postgresql+psycopg2://postgres.[TU-PROJECT-REF]:[TU-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Alternativa con variables separadas:
# DB_USER=postgres
# DB_PASSWORD=[TU-PASSWORD]
# DB_HOST=db.[TU-PROJECT-REF].supabase.co
# DB_PORT=5432
# DB_NAME=postgres

# Para desarrollo local con SQLite (sin Supabase):
# DATABASE_URL=sqlite:///./crm.db


# ==============================================================
# SEGURIDAD — JWT y OTP
# ==============================================================
# Genera una clave segura con:
#   python -c "import secrets; print(secrets.token_hex(32))"

JWT_SECRET_KEY=cambia-esta-clave-por-una-segura-en-produccion
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
OTP_EXPIRATION_MINUTES=10


# ==============================================================
# SERVIDOR
# ==============================================================
PORT=8000
HOST=127.0.0.1
APP_NAME=HardCRM Pro - Big Data & Enterprise API
APP_VERSION=1.0.0


# ==============================================================
# EMAIL — SMTP Gmail (para OTP e invitaciones)
# ==============================================================
# Usa una "App Password" de Google (no tu contraseña normal):
#   https://myaccount.google.com/apppasswords

# ==============================================================
# EMAIL — Resend (recomendado para producción en Render)
# ==============================================================
# Resend usa HTTP, no SMTP — funciona en Render sin restricciones.
# Regístrate en https://resend.com → gratis hasta 3,000 emails/mes
#
# RESEND_FROM_EMAIL: dominio verificado en Resend.
# Para pruebas: onboarding@resend.dev

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=onboarding@resend.dev
EMAIL_FROM_NAME=DataTech Analytics

# ==============================================================
# EMAIL — SMTP Gmail (solo desarrollo local)
# ==============================================================
# Render bloquea SMTP — usa solo en localhost.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USE_SSL=true
EMAIL_USER=tu-correo@gmail.com
EMAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx
EMAIL_FROM=tu-correo@gmail.com

# Lista adicional de destinatarios que también recibirán cada OTP (útil para pruebas y despliegue).
# Separar múltiples direcciones con comas. Dejar vacío para enviar solo al destinatario principal.
# Ejemplo: EMAIL_WHITELIST=dev1@empresa.com,dev2@empresa.com
EMAIL_WHITELIST=


# ==============================================================
# FRONTEND — URL base para enlaces de invitación
# ==============================================================
FRONTEND_URL=http://localhost:5173
