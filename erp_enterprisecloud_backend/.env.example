# ==============================================================
# ERP EnterpriseCloud - Configuración de Entorno
# ==============================================================

# ==============================================================
# BASE DE DATOS - PostgreSQL (AWS RDS)
# ==============================================================
DATABASE_URL=postgresql+psycopg2://erp_admin:password@localhost:5432/erp_enterprisecloud

# Variables separadas
DB_USER=erp_admin
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=erp_enterprisecloud

# ==============================================================
# SEGURIDAD - JWT
# ==============================================================
JWT_SECRET_KEY=tu-clave-super-secreta-cambiar-en-produccion
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==============================================================
# AWS SERVICES
# ==============================================================
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_DEFAULT_REGION=us-east-1
AWS_S3_BUCKET=erp-enterprisecloud-documents

# ==============================================================
# APLICACIÓN
# ==============================================================
APP_NAME=ERP EnterpriseCloud
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1
DEBUG=True
ENVIRONMENT=development

# ==============================================================
# EMPRESA (Configuración inicial)
# ==============================================================
EMPRESA_RUC=20123456789
EMPRESA_RAZON_SOCIAL=Mi Empresa S.A.C.
EMPRESA_NOMBRE_COMERCIAL=Mi Empresa

# ==============================================================
# PARÁMETROS DE NEGOCIO
# ==============================================================
IGV_PORCENTAJE=18
LIMITE_APROBACION_OC=5000
DIAS_CREDITO_DEFAULT=30
STOCK_MINIMO_DEFAULT=10
